# ==========================================================
#  Top.com.do — variables de entorno
#  Copia este archivo a .env y completa los valores.
# ==========================================================

# --- Base de datos (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/topcomdo?sslmode=require

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Correos que se convierten en superadmin al iniciar sesion (separados por coma)
SUPERADMIN_EMAILS=tucorreo@gmail.com
# Secreto para el cron semanal de reinicio de ronda
CRON_SECRET=cambia-esto-por-un-texto-largo-aleatorio

# --- Firebase Admin (verificacion de tokens en el servidor) ---
# Genera el service account en Firebase console > Configuracion > Cuentas de servicio.
# Conviertelo a base64:  Linux/Mac:  base64 -w0 serviceAccount.json
#                        Windows PS: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- PayPal REST API v2 ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- Vercel Blob (almacenamiento de comprobantes) ---
BLOB_READ_WRITE_TOKEN=

# ==========================================================
#  Frontend (Vite) — deben llevar el prefijo VITE_
# ==========================================================
VITE_API_BASE=/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
VITE_PAYPAL_CLIENT_ID=
