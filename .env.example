# ==========================================================
#  Top.com.do — variables de entorno
#  Copia este archivo a .env y completa los valores.
# ==========================================================

# --- Base de datos (Supabase / Neon / cualquier PostgreSQL con SSL) ---
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Correos que se vuelven superadmin al iniciar sesión (separados por coma)
SUPERADMIN_EMAILS=tucorreo@gmail.com
# Secreto para el cron semanal de reinicio de ronda
CRON_SECRET=cambia-esto-por-un-texto-largo-aleatorio

# --- Firebase (autenticación) ---
# El servidor solo necesita el projectId para verificar los tokens (sin service account).
FIREBASE_PROJECT_ID=tu-proyecto

# --- AZUL Payment Page (pasarela única de pago de pujas) ---
# test | prod
AZUL_ENV=test
AZUL_MERCHANT_ID=
AZUL_AUTH_KEY=
AZUL_MERCHANT_NAME=Top.com.do
AZUL_ITBIS_RATE=0

# --- Resend (correo "Te superaron" del growth loop) ---
# Sin esto, el correo no se envía (la notificación in-app y el botón "Recuperar
# #1" siguen funcionando). Verifica el dominio top.com.do en Resend -> Domains.
RESEND_API_KEY=
RESEND_FROM=Top.com.do <no-reply@top.com.do>

# ==========================================================
#  Frontend (Vite) — prefijo VITE_
# ==========================================================
VITE_API_BASE=/api
VITE_SUPERADMIN_EMAILS=tucorreo@gmail.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
